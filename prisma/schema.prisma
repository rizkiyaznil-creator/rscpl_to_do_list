// Skema database untuk aplikasi to-do list rumah sakit.
// Nilai status/role/prioritas disimpan sebagai String (bukan enum native)
// dan divalidasi di sisi aplikasi (lihat src/lib/constants.js).

generator client {
  provider = "prisma-client-js"
  // relationJoins: relasi (include) diambil dalam SATU query SQL (JOIN), bukan
  // satu query per relasi -> jauh lebih sedikit bolak-balik ke database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String? // untuk pengingat tugas via email (opsional)
  role         String   @default("STAFF") // "ADMIN" | "STAFF"
  // "PENDING" | "ACTIVE". Pendaftaran mandiri lewat /daftar mulai dari PENDING
  // dan TIDAK bisa login sampai diverifikasi admin. Akun buatan admin & seed
  // langsung ACTIVE (default ACTIVE agar data lama tidak ikut terkunci).
  status       String   @default("ACTIVE")
  // (Usang) dulu dipakai untuk unit/departemen. Kini digantikan jabatan
  // (positionId). Kolom dibiarkan agar `prisma db push` tidak menghapus data.
  department   String?
  passwordHash String
  createdAt    DateTime @default(now())

  // Jabatan sesuai SOTK (lihat model Position). Null = belum ditetapkan admin.
  positionId Int?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  logEntries    LogEntry[] // logbook kegiatan harian milik user
  logApprovals  LogApproval[]  @relation("logOwner") // minggu logbook user yang sudah disetujui
  logApproved   LogApproval[]  @relation("logApprover") // persetujuan logbook yang diberikan user
  ownedTasks    Task[]         @relation("owner") // tugas yang menjadi tanggung jawab user
  createdTasks  Task[]         @relation("creator") // tugas yang dibuat oleh user
  comments      Comment[] // komentar/handover yang ditulis user
  activities    Activity[] // jejak aktivitas yang dilakukan user
  notifications Notification[] // notifikasi yang ditujukan kepada user
}

// Jabatan dalam struktur organisasi (SOTK), tersusun sebagai pohon melalui
// parentId (atasan langsung). Diisi awal oleh prisma/seed-positions.js dan
// dapat dikelola admin lewat menu "Kelola Jabatan".
model Position {
  id        Int      @id @default(autoincrement())
  name      String // mis. "Manajer Keuangan"
  level     String // DIREKTUR | WADIR | MANAJER | KOORDINATOR | KEPALA | ANGGOTA | STAF
  bidang    String? // mis. "Bidang Medik"; dipakai untuk pengelompokan laporan
  single    Boolean  @default(true) // jabatan struktural hanya boleh diisi 1 orang
  order     Int      @default(0)
  createdAt DateTime @default(now())

  parentId Int?
  parent   Position?  @relation("PositionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Position[] @relation("PositionTree")

  users User[]

  @@index([parentId])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE"
  progress    Int       @default(0) // 0 - 100
  priority    String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId Int
  owner   User @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)

  creatorId Int?
  creator   User? @relation("creator", fields: [creatorId], references: [id], onDelete: SetNull)

  logEntries LogEntry[] // kegiatan logbook yang ditautkan ke tugas ini
  checklist  ChecklistItem[] // sub-tugas / langkah
  comments   Comment[] // komentar & catatan handover
  activities Activity[] // riwayat aktivitas pada tugas ini

  @@index([ownerId])
  @@index([status])
}

// Sub-tugas / langkah pada sebuah tugas. Bila ada item checklist, progress
// tugas dihitung otomatis dari rasio item yang selesai.
model ChecklistItem {
  id        Int      @id @default(autoincrement())
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Komentar / catatan serah-terima (handover) antar personel pada sebuah tugas.
model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId Int?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// Riwayat aktivitas (audit log): siapa melakukan apa & kapan.
// taskId/actorId dibuat nullable + SetNull agar log tetap tersimpan
// meski tugas atau user terkait dihapus.
model Activity {
  id        Int      @id @default(autoincrement())
  action    String // kategori, mis. "CREATE_TASK", "UPDATE_STATUS"
  detail    String? // teks ringkas yang bisa dibaca manusia
  createdAt DateTime @default(now())

  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdAt])
}

// Notifikasi yang ditujukan kepada seorang user (mis. tugas baru ditugaskan,
// komentar baru pada tugas miliknya). Pengingat tenggat TIDAK disimpan di sini
// melainkan dihitung live dari due date (lihat src/lib/notifications.js).
model Notification {
  id        Int      @id @default(autoincrement())
  type      String // "ASSIGNED" | "COMMENT" | dll.
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Penerima notifikasi.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tugas terkait (untuk navigasi saat diklik). Boleh null bila tugas dihapus.
  taskId Int?

  @@index([userId, read])
  @@index([createdAt])
}

// Logbook: catatan kegiatan yang SUDAH dikerjakan personel, per hari.
model LogEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date // tanggal kegiatan (kalender WIB)
  startTime   String // "HH:MM"
  endTime     String // "HH:MM" (boleh melewati tengah malam, mis. jaga malam)
  minutes     Int // durasi dihitung dari jam mulai-selesai
  category    String // kategori baku atau ditulis sendiri ("Lainnya")
  description String // uraian kegiatan
  output      String? // hasil / output
  evidenceUrl String? // link bukti (Google Drive / cloud)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId Int? // tautan opsional ke tugas di Papan Tugas
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// Persetujuan logbook mingguan oleh atasan langsung. Minggu yang sudah
// disetujui TERKUNCI: hanya Direktur/Wadir terkait yang boleh mengubahnya.
model LogApproval {
  id         Int      @id @default(autoincrement())
  weekStart  DateTime @db.Date // Senin pada minggu tsb.
  approvedAt DateTime @default(now())

  userId Int // pemilik logbook
  user   User @relation("logOwner", fields: [userId], references: [id], onDelete: Cascade)

  approvedById Int?
  approvedBy   User? @relation("logApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, weekStart])
}

// Kategori baku logbook yang dikelola admin.
model LogCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
